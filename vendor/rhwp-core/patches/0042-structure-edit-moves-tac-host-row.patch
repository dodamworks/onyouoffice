+    /// 글자처럼 취급 표(캡션 없음)의 지금 표 높이. 그 밖의 컨트롤은 None.
+    pub(crate) fn tac_table_height(
+        &self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+    ) -> Option<i64> {
+        let para = self
+            .document
+            .sections
+            .get(section_idx)?
+            .paragraphs
+            .get(para_idx)?;
+        match para.controls.get(control_idx)? {
+            Control::Table(table) if table.common.treat_as_char && table.caption.is_none() => {
+                Some(i64::from(table.common.height))
+            }
+            _ => None,
+        }
+    }
