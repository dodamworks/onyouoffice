+#[cfg(test)]
+mod tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    /// A treat-as-char table of `rows`×2 in paragraph 0 and four short paragraphs after it,
+    /// saved as HWP and opened again: the stored rows hold the table, as in a file Hangul wrote.
+    fn saved_page_of_table(rows: u16) -> DocumentCore {
+        let mut doc = DocumentCore::new_empty();
+        doc.create_blank_document_native().expect("blank document");
+        doc.insert_text_native(0, 0, 0, "x").expect("type");
+        doc.split_paragraph_native(0, 0, 1, None).expect("split");
+        for para in 1..4 {
+            doc.split_paragraph_native(0, para, 0, None).expect("split");
+        }
+        doc.delete_text_native(0, 0, 0, 1).expect("delete");
+        for para in 1..=4 {
+            doc.insert_text_native(0, para, 0, &format!("closing line {para}"))
+                .expect("type");
+        }
+        doc.create_table_ex_native(0, 0, 0, rows, 2, true, None, None)
+            .expect("table");
+        DocumentCore::from_bytes(&doc.export_hwp_native().expect("save")).expect("reopen")
+    }
+
+    fn table_control(doc: &DocumentCore) -> usize {
+        doc.document().sections[0].paragraphs[0]
+            .controls
+            .iter()
+            .position(|control| matches!(control, Control::Table(_)))
+            .expect("table")
+    }
+
+    /// The host row's text height is the table's outer height, as Hangul stores it.
+    fn host_row_holds_table(doc: &DocumentCore, control: usize) {
+        let para = &doc.document().sections[0].paragraphs[0];
+        let Some(Control::Table(table)) = para.controls.get(control) else {
+            panic!("table");
+        };
+        let band = i64::from(table.common.height)
+            + i64::from(table.outer_margin_top)
+            + i64::from(table.outer_margin_bottom);
+        let row = crate::renderer::layout::control_line_seg_index(para, control).expect("row");
+        assert_eq!(i64::from(para.line_segs[row].text_height), band, "host row height");
+    }
+
+    fn verified_pages(doc: &DocumentCore) -> (u32, u32) {
+        let verify = doc.serialize_hwp_with_verify().expect("verify");
+        (verify.page_count_before, verify.page_count_after)
+    }
+
+    #[test]
+    fn inserted_row_grows_the_stored_host_row_and_pushes_the_next_page() {
+        // 45 rows fill the first page with the closing lines; one more row pushes the last
+        // closing line over (a school newsletter, 2026-11-09: the edited view kept it on the
+        // full page below its bottom, the saved file put it on the next page and the HWP save
+        // check refused the file)
+        let mut doc = saved_page_of_table(45);
+        let control = table_control(&doc);
+        assert_eq!(doc.page_count(), 1, "the saved page holds everything");
+        host_row_holds_table(&doc, control);
+        let following = doc.document().sections[0].paragraphs[1].line_segs[0].vertical_pos;
+        let height = |doc: &DocumentCore| match &doc.document().sections[0].paragraphs[0].controls
+            [control]
+        {
+            Control::Table(table) => i64::from(table.common.height),
+            _ => unreachable!(),
+        };
+        let before = height(&doc);
+
+        doc.insert_table_row_native(0, 0, control, 0, true)
+            .expect("insert a row");
+        let grown = height(&doc) - before;
+        assert!(grown > 0, "the table grows by the row");
+        host_row_holds_table(&doc, control);
+        assert_eq!(
+            i64::from(doc.document().sections[0].paragraphs[1].line_segs[0].vertical_pos),
+            i64::from(following) + grown,
+            "the next paragraph moves down by the row"
+        );
+        assert_eq!(verified_pages(&doc), (2, 2), "edited and reopened pages agree");
+
+        doc.delete_table_row_native(0, 0, control, 1)
+            .expect("delete the row");
+        assert_eq!(height(&doc), before, "the table is back");
+        host_row_holds_table(&doc, control);
+        assert_eq!(
+            doc.document().sections[0].paragraphs[1].line_segs[0].vertical_pos,
+            following,
+            "the next paragraph is back"
+        );
+        assert_eq!(verified_pages(&doc), (1, 1), "back on one page");
+    }
+
+    #[test]
+    fn inserted_column_keeps_the_host_row() {
+        let mut doc = saved_page_of_table(45);
+        let control = table_control(&doc);
+        let rows = doc.document().sections[0].paragraphs[0].line_segs.clone();
+        doc.insert_table_column_native(0, 0, control, 0, true)
+            .expect("insert a column");
+        let after = &doc.document().sections[0].paragraphs[0].line_segs;
+        assert_eq!(after.len(), rows.len());
+        for (a, b) in after.iter().zip(rows.iter()) {
+            assert_eq!(a.text_height, b.text_height, "a column leaves the row height");
+            assert_eq!(a.vertical_pos, b.vertical_pos);
+        }
+        assert_eq!(verified_pages(&doc), (1, 1));
+    }
+}
