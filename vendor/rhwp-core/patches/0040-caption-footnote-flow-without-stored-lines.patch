+///
+/// 한글은 이 그림을 든 줄의 높이를 그림 + 캡션 간격 + 캡션 높이로 저장한다(견본
+/// `2025 행정업무운영 편람`: 16440 + 850 + 1050 = 18340, `issue1853`: 15247 + 850 +
+/// 1000 = 17097). 저장 줄 없이 줄을 만들 때도 같게 잡아야 쪽 나누기가 그리는 쪽과
+/// 같은 높이를 쓴다. 좌·우 캡션은 줄 높이를 바꾸지 않는다.
+pub(crate) fn tac_picture_caption_extent_hwp(pic: &crate::model::image::Picture) -> i32 {
+    use crate::model::shape::CaptionDirection;
+    let Some(caption) = pic.caption.as_ref() else {
+        return 0;
+    };
+    if !matches!(
+        caption.direction,
+        CaptionDirection::Top | CaptionDirection::Bottom
+    ) || caption
+        .paragraphs
+        .iter()
+        .all(|p| p.text.is_empty() && p.controls.is_empty())
+    {
+        return 0;
+    }
+    let dpi = crate::renderer::DEFAULT_DPI;
+    px_to_hwpunit(
+        crate::renderer::composer::caption_height_px(&pic.caption, dpi),
+        dpi,
+    ) + i32::from(caption.spacing)
+}
