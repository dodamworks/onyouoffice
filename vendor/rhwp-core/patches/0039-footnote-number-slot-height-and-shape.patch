+/// 각주 문단에 각주·미주 autoNum 자리표시가 있는지.
+///
+/// 한/글은 각주 번호를 이 자리표시에서만 그린다. 편집기의 각주 넣기는 늘 자리표시를
+/// 만들고, 자리표시를 지운 각주나 번호를 글자로 적은 생성기 문서의 각주는 번호가 없다.
+fn footnote_has_number_slot(paragraphs: &[Paragraph]) -> bool {
+    paragraphs.iter().any(|para| {
+        para.controls.iter().any(|control| {
+            matches!(
+                control,
+                Control::AutoNumber(auto)
+                    if matches!(
+                        auto.number_type,
+                        crate::model::control::AutoNumberType::Footnote
+                            | crate::model::control::AutoNumberType::Endnote
+                    )
+            )
+        })
+    })
+}
