{
  "name": "@genoffice/cli",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "genoffice: the GenOffice command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./agent-skills": "./src/agent-skills.ts",
    "./mcp-launch": "./src/mcp-launch.ts",
    "./control-protocol": "./src/control-protocol.ts"
  },
  "bin": {
    "onyouoffice": "./bin/onyouoffice"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "pack:tarball": "node pack-tarball.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/doc2docx": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/docx2hwp": "*",
    "@genoffice/drawio-model": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/odt-engine": "*",
    "@genoffice/pdf2docx": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-ops": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pngjs": "^7.0.0",
    "undici": "^6.29.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "x-dodam-modified": "Modified by Onyou Office on 2026-10-31 for the independent Onyou Office local development build."
}
